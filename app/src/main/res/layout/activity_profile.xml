<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Toggle -->
    <RelativeLayout
        android:id="@+id/toggleDarkLight"
        android:layout_width="50dp"
        android:layout_height="30dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/toggle_background"
        android:padding="5dp">
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="#121212"/>
    </RelativeLayout>

    <!-- Header -->
    <TextView
        android:id="@+id/txtPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perfil"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp" />

    <!-- Profile Picture -->
    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_below="@id/txtPerfil"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/profile_circle"/>

    <!-- Username -->
    <TextView
        android:id="@+id/txtNombreUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="txtNombreUsuario"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_below="@id/txtPerfil"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="130dp"/>

    <!-- Email -->
    <TextView
        android:id="@+id/txtEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="usuario@email.com"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_below="@id/txtPerfil"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="160dp"/>

    <!-- Botón Editar Perfil -->
    <Button
        android:id="@+id/btnEditarPerfil"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:text="Editar Perfil"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="265dp"/>

    <!-- Favoritos -->
    <Button
        android:id="@+id/btnFavoritos"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="320dp"
        android:layout_centerHorizontal="true"
        android:text="❤️ Mis Favoritos"
        android:background="#1E1E1E"
        android:textColor="#FFFFFF"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>

    <!-- Cerrar sesión -->
    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="🚪 Cerrar Sesión"
        android:background="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_below="@id/btnFavoritos"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</RelativeLayout>
