<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/animeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toggle modo oscuro -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_alignParentEnd="true"
                android:thumbTint="#FFFFFF"
                android:trackTint="#333333" />
        </RelativeLayout>

        <!-- Título del anime -->
        <TextView
            android:id="@+id/tvAnimeTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Naruto Shippuden"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Imagen principal -->
        <ImageView
            android:id="@+id/imgAnime"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/narutoshippuden"
            android:background="@drawable/rounded_image"
            android:layout_marginBottom="16dp" />

        <!-- Nombre japonés -->
        <TextView
            android:id="@+id/tvNombreJapones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre en Japonés"
            android:textColor="#00FFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Género -->
        <TextView
            android:id="@+id/tvGenero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Género: Acción, Aventura"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Año -->
        <TextView
            android:id="@+id/tvAnio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Año: 2023"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- PG -->
        <TextView
            android:id="@+id/tvPG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PG: +13"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Sinopsis -->
        <TextView
            android:id="@+id/tvSinopsisLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sinopsis:"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSinopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí va la descripción detallada del anime..."
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Lista de episodios -->
        <TextView
            android:id="@+id/tvEpisodiosLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Episodios:"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/listaEpisodios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ejemplo de un episodio -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:text="EP1: El comienzo de todo"
                android:textColor="#000000"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#EEEEEE"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
