<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anime"
        tools:targetApi="31">

        <!-- LoginActivity: inicia la app -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true"
            android:label="Login"
            android:theme="@style/Theme.Anime.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegisterActivity -->
        <activity
            android:name=".activity.RegisterActivity"
            android:exported="true"
            android:label="Register"
            android:theme="@style/Theme.Anime.NoActionBar" />

        <!-- HomeActivity -->
        <activity
            android:name=".activity.HomeActivity"
            android:exported="true"
            android:label="Home"
            android:theme="@style/Theme.Anime.NoActionBar" />

        <!-- AnimeActivity (detalle de anime + episodios) -->
        <activity
            android:name=".activity.AnimeActivity"
            android:exported="true"
            android:label="Anime"
            android:theme="@style/Theme.Anime.NoActionBar" />

        <!-- VideoActivity (pantalla de reproducción) -->
        <activity
            android:name=".activity.VideoActivity"
            android:exported="true"
            android:label="Video"
            android:theme="@style/Theme.Anime.NoActionBar" />

        <!-- Perfil -->
        <activity
            android:name=".activity.ProfileActivity"
            android:exported="true"
            android:label="Perfil"
            android:theme="@style/Theme.Anime.NoActionBar" />

        <!-- Favoritos -->
        <activity
            android:name=".activity.FavoritosActivity"
            android:exported="true"
            android:label="Favoritos"
            android:theme="@style/Theme.Anime.NoActionBar" />

        <!-- MainActivity (pruebas) -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Anime.NoActionBar" />

    </application>

</manifest>